diff -ruN berkah-rev/berkah-oyot-storefront-sample/src/app/globals.css berkah-style-refresh/src/app/globals.css
--- berkah-rev/berkah-oyot-storefront-sample/src/app/globals.css	2026-08-02 11:47:24.411469140 +0000
+++ berkah-style-refresh/src/app/globals.css	2026-08-02 12:13:00.419514454 +0000
@@ -670,3 +670,931 @@
   .shipping-label { position: static; width: 105mm; min-height: 148mm; margin-inline: auto; padding: 9mm; }
   .print-invoice { width: 100%; }
 }
+
+/* ===== V3 DESIGN REFRESH ===== */
+:root {
+  --ink: #1d2340;
+  --ink-2: #30395d;
+  --muted: #66708c;
+  --line: #d9dfef;
+  --line-dark: #c8d1e6;
+  --paper: #ffffff;
+  --canvas: #f5f6fb;
+  --canvas-2: #eef2fb;
+  --forest: #0e9f6e;
+  --forest-dark: #0b8059;
+  --acid: #ffd75f;
+  --sand: #8d8ab5;
+  --danger: #d04d56;
+  --success: #159570;
+  --shadow: 0 24px 80px rgba(31, 42, 82, 0.12);
+  --serif: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+body {
+  background:
+    radial-gradient(circle at top left, rgba(144, 116, 255, 0.09), transparent 26%),
+    radial-gradient(circle at top right, rgba(14, 159, 110, 0.09), transparent 18%),
+    var(--canvas);
+}
+
+.section--tight { padding: 40px 0; }
+.section-kicker { color: #6b55f8; }
+.button {
+  min-height: 50px;
+  border-radius: 999px;
+  box-shadow: none;
+}
+.button--primary {
+  color: #fff;
+  background: linear-gradient(135deg, #6b55f8 0%, #24a673 100%);
+}
+.button--secondary,
+.button--ghost,
+.button--outline {
+  border-radius: 999px;
+}
+
+.utility-bar {
+  background: rgba(255,255,255,.8);
+  border-bottom: 1px solid rgba(201, 209, 231, 0.85);
+  backdrop-filter: blur(14px);
+}
+.utility-bar__inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  min-height: 40px;
+}
+.utility-bar span {
+  font-size: .73rem;
+  color: var(--muted);
+}
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  background: rgba(245,246,251,.82);
+  backdrop-filter: blur(14px);
+  border-bottom: 1px solid rgba(201, 209, 231, 0.7);
+}
+.site-header__inner {
+  min-height: 80px;
+}
+.brand {
+  gap: 12px;
+}
+.brand img {
+  width: 48px;
+  height: 48px;
+  border-radius: 14px;
+  box-shadow: 0 12px 24px rgba(79, 91, 168, 0.18);
+}
+.brand strong {
+  font-size: .95rem;
+  letter-spacing: -0.03em;
+}
+.brand span {
+  font-size: .73rem;
+  color: var(--muted);
+  letter-spacing: 0;
+}
+.desktop-nav {
+  gap: 10px;
+}
+.desktop-nav a,
+.category-nav a {
+  border-radius: 999px;
+}
+.desktop-nav a {
+  padding: 10px 14px;
+  color: var(--ink-2);
+  font-size: .84rem;
+  font-weight: 700;
+}
+.desktop-nav a:hover {
+  background: rgba(107, 85, 248, 0.08);
+}
+.header-actions {
+  gap: 10px;
+}
+.header-search-chip {
+  min-height: 42px;
+  padding: 0 14px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid var(--line-dark);
+  border-radius: 999px;
+  color: var(--muted);
+  background: rgba(255,255,255,.9);
+  font-size: .8rem;
+}
+.header-action,
+.account-link,
+.mobile-menu-button {
+  min-height: 42px;
+  border-radius: 999px;
+  background: rgba(255,255,255,.95);
+  border: 1px solid var(--line-dark);
+}
+.account-link {
+  padding: 0 16px;
+  gap: 8px;
+  color: var(--ink);
+}
+.cart-link {
+  min-width: 42px;
+  position: relative;
+}
+.cart-link span {
+  position: absolute;
+  top: -6px;
+  right: -4px;
+  min-width: 22px;
+  height: 22px;
+  display: grid;
+  place-items: center;
+  border-radius: 999px;
+  color: #fff;
+  background: linear-gradient(135deg, #6b55f8 0%, #24a673 100%);
+  font-size: .7rem;
+  font-weight: 800;
+}
+.category-nav-wrap {
+  border-top: 0;
+  background: transparent;
+}
+.category-nav {
+  min-height: 56px;
+  gap: 10px;
+}
+.category-nav a {
+  padding: 10px 14px;
+  color: var(--muted);
+  font-size: .76rem;
+  font-weight: 700;
+  background: rgba(255,255,255,.72);
+  border: 1px solid transparent;
+}
+.category-nav a:hover,
+.category-nav__all {
+  color: var(--ink);
+  border-color: var(--line-dark);
+}
+.mobile-nav {
+  padding: 12px 0 20px;
+  border-top: 1px solid rgba(201, 209, 231, 0.7);
+  background: transparent;
+}
+.mobile-nav a {
+  min-height: 48px;
+  padding: 0 16px;
+  display: flex;
+  align-items: center;
+  border: 1px solid var(--line);
+  border-radius: 18px;
+  background: rgba(255,255,255,.92);
+}
+
+.home-showcase__wrap {
+  display: grid;
+  grid-template-columns: 1.08fr 1.3fr 280px;
+  gap: 22px;
+  align-items: stretch;
+}
+.home-showcase__intro,
+.home-showcase__visual,
+.home-showcase__dna {
+  min-width: 0;
+}
+.home-showcase__intro {
+  padding: 30px 0 16px;
+}
+.home-showcase__intro h1 {
+  margin: 16px 0 18px;
+  font-size: clamp(3rem, 5vw, 4.7rem);
+  line-height: .98;
+  letter-spacing: -0.06em;
+}
+.home-showcase__intro p {
+  max-width: 560px;
+  font-size: 1rem;
+}
+.home-showcase__actions {
+  margin-top: 28px;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  flex-wrap: wrap;
+}
+.secondary-cta {
+  min-height: 50px;
+  padding: 0 18px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid var(--line-dark);
+  border-radius: 999px;
+  background: rgba(255,255,255,.9);
+  font-size: .88rem;
+  font-weight: 700;
+}
+.home-showcase__chips {
+  margin-top: 24px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+.home-showcase__chips span {
+  min-height: 38px;
+  padding: 0 14px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  border-radius: 999px;
+  color: var(--ink-2);
+  background: rgba(255,255,255,.82);
+  border: 1px solid var(--line);
+  font-size: .76rem;
+  font-weight: 700;
+}
+.home-showcase__visual {
+  position: relative;
+  padding: 18px;
+  border: 1px solid rgba(210, 217, 238, 0.9);
+  border-radius: 34px;
+  background: linear-gradient(180deg, rgba(255,255,255,.95), rgba(247,249,255,.88));
+  box-shadow: var(--shadow);
+  overflow: hidden;
+}
+.showcase-canvas {
+  min-height: 570px;
+  position: relative;
+  border-radius: 28px;
+  background: linear-gradient(180deg, #f9fbff 0%, #eef3ff 100%);
+  overflow: hidden;
+}
+.showcase-stage {
+  position: absolute;
+  border-radius: 24px;
+  overflow: hidden;
+  box-shadow: 0 22px 60px rgba(79, 91, 168, 0.16);
+}
+.showcase-stage img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.showcase-stage--storefront {
+  inset: 18px 170px 126px 18px;
+}
+.showcase-stage--dashboard {
+  width: 270px;
+  left: 18px;
+  bottom: 18px;
+  aspect-ratio: 1.24;
+}
+.showcase-stage--mobile {
+  width: 250px;
+  right: 24px;
+  top: 48px;
+  aspect-ratio: .51;
+  border: 6px solid #111a38;
+  border-radius: 38px;
+}
+.showcase-sticky {
+  position: absolute;
+  left: 24px;
+  bottom: 22px;
+}
+.sticky-note {
+  width: 195px;
+  padding: 16px;
+  display: grid;
+  gap: 6px;
+  border-radius: 18px;
+  box-shadow: 0 14px 32px rgba(51, 60, 111, 0.16);
+  transform: rotate(-3deg);
+}
+.sticky-note strong {
+  font-size: .86rem;
+}
+.sticky-note span {
+  color: #4f5772;
+  font-size: .72rem;
+  line-height: 1.45;
+}
+.sticky-note--yellow { background: #ffe28c; }
+.sticky-note--purple {
+  width: auto;
+  transform: rotate(-2deg);
+  background: #ded6ff;
+}
+.doodle {
+  position: absolute;
+  pointer-events: none;
+}
+.doodle--arc {
+  top: 10px;
+  right: 96px;
+  width: 70px;
+}
+.doodle--star {
+  right: 40px;
+  bottom: 92px;
+  width: 34px;
+}
+.home-showcase__dna {
+  display: grid;
+  gap: 14px;
+}
+.dna-card {
+  padding: 24px 22px;
+  border: 1px solid rgba(210, 217, 238, 0.9);
+  border-radius: 26px;
+  background: rgba(255,255,255,.82);
+}
+.dna-card h3 {
+  margin-bottom: 10px;
+  font-size: 1.15rem;
+}
+.dna-card p { font-size: .9rem; }
+.dna-card--compact {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
