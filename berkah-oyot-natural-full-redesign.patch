+    background: #fff;
+  }
+
+  .site-header,
+  .site-footer,
+  .utility-bar {
+    display: none !important;
+  }
+
+  .order-card,
+  .shipping-label,
+  .print-invoice {
+    border: 0;
+    box-shadow: none;
+    background: #fff;
+  }
+}
+
+/* Compatibility with the earlier header/footer refresh patch */
+.utility-bar__inner {
+  min-height: 36px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+}
+
+.header-search-chip {
+  min-height: 42px;
+  padding: 0 14px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid var(--natural-line);
+  border-radius: 999px;
+  color: #667168;
+  background: rgba(255, 255, 255, 0.72);
+  font-size: 0.78rem;
+  font-weight: 600;
+}
+
+.footer-showcase {
+  margin-bottom: 24px;
+  padding: 30px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  border: 1px solid var(--natural-line);
+  border-radius: 24px;
+  background: rgba(255, 253, 248, 0.7);
+}
+
+.footer-showcase h2 {
+  margin: 8px 0 10px;
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2rem, 3vw, 3rem);
+  font-weight: 500;
+  letter-spacing: -0.04em;
+}
+
+.footer-cta {
+  min-height: 48px;
+  padding: 0 20px;
+  display: inline-flex;
+  align-items: center;
+  border-radius: 9px;
+  color: #fff;
+  background: var(--natural-green);
+  font-size: 0.86rem;
+  font-weight: 700;
+}
+
+@media (max-width: 760px) {
+  .utility-bar__inner,
+  .footer-showcase {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .header-search-chip {
+    display: none;
+  }
+}
