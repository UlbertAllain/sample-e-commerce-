diff --git a/src/app/natural-theme.css b/src/app/natural-theme.css
new file mode 100644
index 0000000..4b4fdae
--- /dev/null
+++ b/src/app/natural-theme.css
@@ -0,0 +1,1540 @@
+:root {
+  --natural-ink: #17362c;
+  --natural-ink-soft: #30483d;
+  --natural-muted: #687369;
+  --natural-line: rgba(39, 67, 55, 0.14);
+  --natural-paper: #fffdf8;
+  --natural-canvas: #efe8dc;
+  --natural-canvas-soft: #f7f2e9;
+  --natural-green: #5f8f4f;
+  --natural-green-dark: #2c5b47;
+  --natural-green-soft: #dfead8;
+  --natural-gold: #b49b60;
+  --natural-shadow: 0 16px 44px rgba(69, 68, 49, 0.09);
+  --natural-radius: 26px;
+}
+
+html {
+  background: var(--natural-canvas);
+}
+
+body {
+  color: var(--natural-ink);
+  background:
+    radial-gradient(circle at top left, rgba(186, 168, 137, 0.15), transparent 26%),
+    linear-gradient(180deg, #f4eee4 0%, var(--natural-canvas) 100%);
+}
+
+body,
+button,
+input,
+textarea,
+select {
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+h1,
+h2,
+h3,
+h4 {
+  color: var(--natural-ink);
+}
+
+p {
+  color: var(--natural-muted);
+}
+
+.shell {
+  width: min(1280px, calc(100% - 48px));
+}
+
+.section {
+  padding: 82px 0;
+}
+
+.section--soft {
+  background: rgba(248, 244, 236, 0.78);
+  border-top: 1px solid var(--natural-line);
+  border-bottom: 1px solid var(--natural-line);
+}
+
+.eyebrow,
+.section-kicker {
+  color: var(--natural-green-dark);
+  font-size: 0.72rem;
+  font-weight: 800;
+  letter-spacing: 0.13em;
+  text-transform: uppercase;
+}
+
+.eyebrow--light,
+.section-kicker--light {
+  color: rgba(255, 255, 255, 0.82);
+}
+
+.button {
+  min-height: 48px;
+  padding: 0 20px;
+  border-radius: 9px;
+  font-size: 0.88rem;
+  font-weight: 700;
+  letter-spacing: 0;
+  box-shadow: none;
+}
+
+.button--primary {
+  color: #fff;
+  background: var(--natural-green);
+  border-color: var(--natural-green);
+}
+
+.button--primary:hover {
+  background: #4f7e42;
+  border-color: #4f7e42;
+}
+
+.button--secondary {
+  color: var(--natural-green-dark);
+  background: var(--natural-paper);
+  border: 1px solid rgba(44, 91, 71, 0.22);
+}
+
+.button--dark {
+  color: #fff;
+  background: var(--natural-green-dark);
+}
+
+.full-width {
+  width: 100%;
+}
+
+.inline-link,
+.text-action,
+.edit-link,
+.auth-back,
+.auth-switch a {
+  color: var(--natural-green-dark);
+  font-weight: 700;
+}
+
+/* Header */
+.utility-bar {
+  background: rgba(247, 242, 233, 0.92);
+  border-bottom: 1px solid var(--natural-line);
+}
+
+.utility-bar .shell {
+  min-height: 36px;
+}
+
+.utility-bar span {
+  color: #667268;
+  font-size: 0.72rem;
+}
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 50;
+  background: rgba(255, 253, 248, 0.93);
+  border-bottom: 1px solid var(--natural-line);
+  backdrop-filter: blur(14px);
+}
+
+.site-header__inner {
+  min-height: 78px;
+}
+
+.brand {
+  gap: 12px;
+}
+
+.brand img {
+  width: 48px;
+  height: 48px;
+  border-radius: 0;
+  box-shadow: none;
+}
+
+.brand strong {
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 1.08rem;
+  font-weight: 500;
+  letter-spacing: -0.02em;
+}
+
+.brand span {
+  color: #6d786f;
+  font-size: 0.68rem;
+  letter-spacing: 0.08em;
+}
+
+.desktop-nav {
+  gap: 26px;
+}
+
+.desktop-nav a {
+  padding: 8px 0;
+  color: var(--natural-ink-soft);
+  font-size: 0.88rem;
+  font-weight: 600;
+  border-bottom: 1px solid transparent;
+}
+
+.desktop-nav a:hover {
+  color: var(--natural-green-dark);
+  border-bottom-color: var(--natural-green-dark);
+}
+
+.header-actions {
+  gap: 10px;
+}
+
+.header-action,
+.account-link,
+.mobile-menu-button {
+  min-height: 42px;
+  border: 1px solid var(--natural-line);
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.72);
+}
+
+.header-action {
+  width: 42px;
+}
+
+.account-link {
+  padding: 0 15px;
+  gap: 8px;
+  color: var(--natural-ink-soft);
+  font-size: 0.82rem;
+  font-weight: 700;
+}
+
+.cart-link {
+  position: relative;
+}
+
+.cart-link > span {
+  position: absolute;
+  top: -5px;
+  right: -4px;
+  min-width: 20px;
+  height: 20px;
+  display: grid;
+  place-items: center;
+  border-radius: 999px;
+  color: #fff;
+  background: var(--natural-green);
+  font-size: 0.66rem;
+  font-weight: 800;
+}
+
+.category-nav-wrap {
+  border-top: 1px solid rgba(39, 67, 55, 0.08);
+  background: rgba(252, 249, 242, 0.84);
+}
+
+.category-nav {
+  min-height: 48px;
+  gap: 28px;
+}
+
+.category-nav a {
+  color: #59685f;
+  font-size: 0.78rem;
+  font-weight: 600;
+}
+
