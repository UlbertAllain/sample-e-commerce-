+.orders-panel {
+  border: 1px solid var(--natural-line);
+  border-radius: 24px;
+  background: rgba(255, 253, 248, 0.88);
+  box-shadow: var(--natural-shadow);
+}
+
+.account-panel,
+.orders-panel {
+  padding: 28px;
+}
+
+.account-note {
+  padding: 26px;
+  color: #fff;
+  background: var(--natural-green-dark);
+}
+
+.account-note h3,
+.account-note a {
+  color: #fff;
+}
+
+.account-note p {
+  color: rgba(255, 255, 255, 0.76);
+}
+
+.profile-summary {
+  border-top-color: var(--natural-line);
+}
+
+.order-history > a {
+  border-color: var(--natural-line);
+  border-radius: 16px;
+  background: rgba(255, 255, 255, 0.58);
+}
+
+.order-history > a:hover {
+  border-color: rgba(95, 143, 79, 0.4);
+  background: rgba(241, 246, 236, 0.9);
+}
+
+.success-banner {
+  border: 1px solid rgba(95, 143, 79, 0.28);
+  border-radius: 14px;
+  color: var(--natural-green-dark);
+  background: rgba(232, 242, 225, 0.94);
+}
+
+/* Checkout */
+.checkout-heading {
+  padding-bottom: 28px;
+  border-bottom: 1px solid var(--natural-line);
+}
+
+.checkout-steps span {
+  color: #7a857d;
+}
+
+.checkout-steps span.active,
+.checkout-steps span.complete {
+  color: var(--natural-green-dark);
+}
+
+.checkout-layout {
+  grid-template-columns: minmax(0, 1fr) 390px;
+  gap: 28px;
+}
+
+.checkout-main {
+  gap: 20px;
+}
+
+.checkout-block {
+  padding: 28px;
+  border: 1px solid var(--natural-line);
+  border-radius: 24px;
+  background: rgba(255, 253, 248, 0.88);
+  box-shadow: var(--natural-shadow);
+}
+
+.block-heading {
+  border-bottom-color: var(--natural-line);
+}
+
+.block-icon {
+  color: var(--natural-green-dark);
+  background: var(--natural-green-soft);
+}
+
+.block-heading h2 {
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 1.5rem;
+  font-weight: 500;
+}
+
+.address-sheet {
+  border: 1px solid var(--natural-line);
+  border-radius: 18px;
+  background: rgba(247, 244, 236, 0.82);
+}
+
+.address-sheet__person svg {
+  color: var(--natural-green-dark);
+}
+
+.choice-list {
+  gap: 12px;
+}
+
+.choice-card,
+.payment-choices label {
+  border: 1px solid var(--natural-line);
+  border-radius: 16px;
+  background: rgba(255, 255, 255, 0.74);
+}
+
+.choice-card.active,
+.payment-choices label.active {
+  border-color: var(--natural-green);
+  background: rgba(238, 246, 232, 0.92);
+}
+
+.choice-card__mark {
+  border-color: rgba(44, 91, 71, 0.32);
+}
+
+.choice-card.active .choice-card__mark {
+  color: #fff;
+  background: var(--natural-green);
+  border-color: var(--natural-green);
+}
+
+.payment-choices label b {
+  color: var(--natural-green-dark);
+  background: var(--natural-green-soft);
+}
+
+.checkout-summary {
+  top: 152px;
+}
+
+.summary-title,
+.checkout-items article,
+.price-lines {
+  border-color: var(--natural-line);
+}
+
+.checkout-items article img {
+  border-radius: 12px;
+  background: #edf1e9;
+}
+
+.voucher-field input,
+.voucher-field button {
+  min-height: 46px;
+}
+
+.voucher-field button {
+  color: #fff;
+  border: 0;
+  border-radius: 10px;
+  background: var(--natural-green-dark);
+}
+
+.summary-security {
+  color: #6b776e;
+  background: rgba(242, 239, 231, 0.76);
+  border-radius: 12px;
+}
+
+/* Payment */
+.payment-shell {
+  max-width: 1120px;
+}
+
+.payment-heading {
+  max-width: 760px;
+}
+
+.status-pill {
+  color: var(--natural-green-dark);
+  background: var(--natural-green-soft);
+  border: 1px solid rgba(95, 143, 79, 0.26);
+  border-radius: 999px;
+}
+
+.status-pill--pending {
+  color: #786231;
+  background: #f3ead2;
+  border-color: rgba(180, 155, 96, 0.28);
+}
+
+.payment-layout {
+  grid-template-columns: minmax(0, 1fr) 340px;
+  gap: 26px;
+}
+
+.payment-card,
+.order-mini-card,
+.order-card {
+  border: 1px solid var(--natural-line);
+  border-radius: 24px;
+  background: rgba(255, 253, 248, 0.9);
+  box-shadow: var(--natural-shadow);
+}
+
+.payment-card,
+.order-mini-card {
+  padding: 28px;
+}
+
+.qris-panel,
+.bank-panel {
+  border: 1px solid var(--natural-line);
+  border-radius: 18px;
+  background: rgba(247, 244, 236, 0.84);
+}
+
+.bank-logo {
+  color: var(--natural-green-dark);
+}
+
+.account-number {
+  border-color: var(--natural-line);
+  background: rgba(255, 255, 255, 0.75);
+}
+
+.account-number button {
+  color: var(--natural-green-dark);
+}
+
+.payment-total {
+  border-color: var(--natural-line);
+}
+
+.payment-total strong {
+  color: var(--natural-green-dark);
+  font-family: Georgia, "Times New Roman", serif;
+  font-weight: 600;
+}
+
+.secure-note {
+  border-radius: 14px;
+  color: #66736b;
+  background: rgba(239, 243, 235, 0.88);
+}
+
+.order-mini-card h2 {
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-weight: 500;
+}
+
+.order-mini-card article,
+.order-mini-card > div {
+  border-color: var(--natural-line);
+}
+
+.order-mini-card article img {
+  border-radius: 12px;
+  background: #edf1e9;
+}
+
+/* Order and documents */
+.order-success {
+  padding: 30px;
+  border: 1px solid var(--natural-line);
+  border-radius: 26px;
+  background: rgba(255, 253, 248, 0.88);
+  box-shadow: var(--natural-shadow);
+}
+
+.order-success__icon {
+  color: #fff;
+  background: var(--natural-green);
+}
+
+.order-success h1,
+.order-card__heading h2 {
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-weight: 500;
+}
+
+.order-actions {
+  gap: 10px;
+}
+
+.order-layout {
+  grid-template-columns: minmax(0, 1fr) 360px;
+  gap: 24px;
+}
+
+.order-card {
+  padding: 28px;
+}
+
+.order-card__heading {
+  border-bottom-color: var(--natural-line);
+}
+
+.tracking-number,
+.label-route,
+.label-service,
+.label-order,
+.label-warning,
+.invoice-meta,
+.invoice-row,
+.invoice-totals {
+  border-color: var(--natural-line);
+}
+
+.timeline::before {
+  background: var(--natural-line);
+}
+
+.timeline__dot {
+  color: var(--natural-green-dark);
+  border-color: rgba(95, 143, 79, 0.34);
+  background: var(--natural-paper);
+}
+
+.timeline article.completed .timeline__dot {
+  color: #fff;
+  background: var(--natural-green);
+  border-color: var(--natural-green);
+}
+
+.invoice-brand strong,
+.label-header strong {
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+}
+
+.invoice-row--head {
+  color: var(--natural-ink-soft);
+  background: rgba(239, 235, 225, 0.72);
+}
+
+.invoice-totals strong,
+.label-resi {
+  color: var(--natural-green-dark);
+}
+
+.shipping-label {
+  background: #fff;
+}
+
+.label-warning {
+  color: #725f34;
+  background: #f5ecd4;
+}
+
+/* Tracking */
+.page-hero--tracking {
+  background:
+    linear-gradient(90deg, rgba(255, 253, 248, 0.92), rgba(225, 232, 217, 0.76)),
+    var(--natural-canvas-soft);
+}
+
+.tracking-hero svg {
+  color: var(--natural-green-dark);
+}
+
+.tracking-search {
+  padding: 12px;
+  border: 1px solid var(--natural-line);
+  border-radius: 18px;
+  background: rgba(255, 253, 248, 0.88);
+  box-shadow: var(--natural-shadow);
+}
+
+.tracking-search input {
+  background: transparent;
+}
+
+.tracking-hint button {
+  color: var(--natural-green-dark);
+}
+
+.tracking-result {
+  padding: 28px;
+  border: 1px solid var(--natural-line);
+  border-radius: 24px;
+  background: rgba(255, 253, 248, 0.9);
+  box-shadow: var(--natural-shadow);
+}
+
+.tracking-summary {
+  border-color: var(--natural-line);
+  background: rgba(244, 241, 232, 0.7);
+  border-radius: 16px;
+}
+
+.timeline--wide article {
+  border-color: var(--natural-line);
+}
+
+/* Responsive */
+@media (max-width: 1120px) {
+  .catalog-layout,
+  .product-detail,
+  .cart-layout,
+  .checkout-layout,
+  .payment-layout,
+  .order-layout,
+  .account-layout {
+    grid-template-columns: 1fr;
+  }
+
+  .catalog-sidebar,
+  .cart-layout .summary-card,
+  .checkout-summary {
+    position: static;
+  }
+
+  .catalog-sidebar {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 8px;
+  }
+
+  .sidebar-title {
+    grid-column: 1 / -1;
+  }
+
+  .catalog-sidebar button {
+    padding: 12px;
+    border: 1px solid var(--natural-line);
+    border-radius: 10px;
+    background: rgba(255, 255, 255, 0.5);
+  }
+
+  .product-gallery__main {
+    min-height: 460px;
+  }
+
+  .auth-page,
+  .register-page {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 860px) {
+  .shell,
+  .auth-page,
+  .register-page {
+    width: min(100% - 30px, 1280px);
+  }
+
+  .desktop-nav,
+  .category-nav-wrap {
+    display: none;
+  }
+
+  .product-grid--catalog,
+  .product-grid--three {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .catalog-sidebar {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .cart-item {
+    grid-template-columns: 96px 1fr;
+  }
+
+  .cart-item > img {
+    width: 96px;
+  }
+
+  .cart-item__price {
+    grid-column: 2;
+    justify-items: start;
+  }
+
+  .footer-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 620px) {
+  .section {
+    padding: 58px 0;
+  }
+
+  .page-hero {
+    padding: 52px 0 46px;
+  }
+
+  .page-hero h1,
+  .page-heading h1,
+  .checkout-heading h1,
+  .payment-heading h1 {
+    font-size: 2.45rem;
+  }
+
+  .product-grid--catalog,
+  .product-grid--three,
+  .catalog-sidebar,
+  .footer-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .catalog-toolbar,
+  .page-heading,
+  .checkout-heading,
+  .payment-heading,
+  .panel-heading,
+  .order-actions {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .catalog-toolbar select {
+    min-height: 50px;
+    width: 100%;
+  }
+
+  .product-gallery__main {
+    min-height: 330px;
+  }
+
+  .product-info h1 {
+    font-size: 2.5rem;
+  }
+
+  .purchase-row {
+    flex-direction: column;
+  }
+
+  .quantity-stepper {
+    width: 100%;
+  }
+
+  .cart-list,
+  .summary-card,
+  .checkout-block,
+  .payment-card,
+  .order-mini-card,
+  .order-card,
+  .account-panel,
+  .orders-panel,
+  .account-head,
+  .auth-page__visual,
+  .auth-page__form-wrap,
+  .register-aside,
+  .register-main,
+  .tracking-result {
+    padding: 22px;
+    border-radius: 20px;
+  }
+
+  .cart-item {
+    grid-template-columns: 76px 1fr;
+    gap: 14px;
+  }
+
+  .cart-item > img {
+    width: 76px;
+  }
+
+  .checkout-steps {
+    display: none;
+  }
+
+  .payment-choices {
+    grid-template-columns: 1fr;
+  }
+
+  .tracking-search {
+    display: grid;
+    grid-template-columns: auto 1fr;
+  }
+
+  .tracking-search .button {
+    grid-column: 1 / -1;
+  }
+}
+
+@media print {
+  body {
+    background: #fff;
+  }
+
+  .site-header,
+  .site-footer,
+  .utility-bar {
+    display: none !important;
+  }
+
+  .order-card,
+  .shipping-label,
+  .print-invoice {
+    border: 0;
+    box-shadow: none;
+    background: #fff;
+  }
+}
+
+/* Compatibility with the earlier header/footer refresh patch */
+.utility-bar__inner {
+  min-height: 36px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+}
+
+.header-search-chip {
+  min-height: 42px;
+  padding: 0 14px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid var(--natural-line);
+  border-radius: 999px;
+  color: #667168;
+  background: rgba(255, 255, 255, 0.72);
+  font-size: 0.78rem;
+  font-weight: 600;
+}
+
+.footer-showcase {
+  margin-bottom: 24px;
+  padding: 30px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  border: 1px solid var(--natural-line);
+  border-radius: 24px;
+  background: rgba(255, 253, 248, 0.7);
+}
+
+.footer-showcase h2 {
+  margin: 8px 0 10px;
+  color: var(--natural-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2rem, 3vw, 3rem);
+  font-weight: 500;
+  letter-spacing: -0.04em;
+}
+
+.footer-cta {
+  min-height: 48px;
+  padding: 0 20px;
+  display: inline-flex;
+  align-items: center;
+  border-radius: 9px;
+  color: #fff;
+  background: var(--natural-green);
+  font-size: 0.86rem;
+  font-weight: 700;
+}
+
+@media (max-width: 760px) {
+  .utility-bar__inner,
+  .footer-showcase {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .header-search-chip {
+    display: none;
+  }
+}
