-.label-route span, .label-order span { color: var(--muted); font-size: .58rem; font-weight: 900; letter-spacing: .1em; }
-.label-route strong { display: block; margin: 5px 0; font-size: .82rem; }
-.label-route p { font-size: .67rem; line-height: 1.5; }
-.label-service { margin: 16px 0; display: flex; align-items: center; justify-content: space-between; }
-.label-service strong { font-size: 1.55rem; }
-.label-service span { padding: 6px 9px; border: 2px solid var(--ink); font-size: .68rem; font-weight: 900; }
-.barcode { height: 58px; display: flex; align-items: stretch; justify-content: space-between; gap: 2px; overflow: hidden; }
-.barcode i { background: var(--ink); }
-.label-resi { display: block; margin-top: 8px; text-align: center; font-size: .76rem; letter-spacing: .08em; }
-.label-order { margin-top: 18px; padding: 11px; display: flex; justify-content: space-between; border: 2px solid var(--ink); }
-.label-warning { margin-top: 13px; padding: 10px; color: white; background: var(--ink); text-align: center; font-size: .57rem; font-weight: 900; letter-spacing: .07em; }
+.label-header strong { font-family: var(--serif); font-size: 1.15rem; }
+.label-header span { font-size: 0.56rem; letter-spacing: 0.13em; }
+.label-header b { padding: 7px 10px; border: 2px solid var(--ink); font-size: 0.7rem; }
+.label-route { display: grid; grid-template-columns: 1fr 1fr; }
+.label-route > div { padding: 15px 0; }
+.label-route > div + div { padding-left: 15px; border-left: 1px solid var(--ink); }
+.label-route span { font-size: 0.55rem; font-weight: 800; letter-spacing: 0.1em; }
+.label-route strong { margin: 5px 0; display: block; font-size: 0.73rem; }
+.label-route p { color: var(--ink); font-size: 0.61rem; line-height: 1.5; }
+.label-service { padding: 13px 0; display: flex; justify-content: space-between; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
+.label-service strong { font-size: 1rem; }
+.label-service span { font-size: 0.7rem; }
+.barcode { height: 70px; margin-top: 18px; display: flex; align-items: stretch; justify-content: center; gap: 2px; }
+.barcode i { display: block; background: var(--ink); }
+.label-resi { margin-top: 8px; display: block; text-align: center; font-size: 0.8rem; letter-spacing: 0.09em; }
+.label-order { margin-top: 14px; padding: 10px; display: flex; justify-content: space-between; border: 1px solid var(--ink); }
+.label-order span { font-size: 0.58rem; font-weight: 800; }
+.label-order strong { font-size: 0.7rem; }
+.label-warning { margin-top: 10px; padding: 9px; color: #fff; background: var(--ink); text-align: center; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.05em; }
 
 /* Tracking */
-.page-hero--tracking { padding-block: 70px; }
-.tracking-hero { display: flex; align-items: center; justify-content: space-between; gap: 30px; }
-.tracking-hero svg { color: var(--acid); }
-.tracking-search { max-width: 850px; min-height: 64px; margin: -32px auto 0; padding: 7px 7px 7px 19px; display: flex; align-items: center; gap: 11px; border: 1px solid var(--line-dark); background: white; box-shadow: var(--shadow); }
-.tracking-search input { flex: 1; border: 0; outline: 0; }
-.tracking-hint { margin-top: 14px; text-align: center; font-size: .68rem; }
-.tracking-hint button { border: 0; color: var(--forest); background: transparent; cursor: pointer; font-weight: 900; }
-.tracking-section .empty-card { margin-top: 35px; }
-.tracking-result { max-width: 900px; margin: 35px auto 0; padding: 30px; border: 1px solid var(--line-dark); background: var(--paper); }
-.tracking-summary { padding-bottom: 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; border-bottom: 1px solid var(--line-dark); }
-.tracking-summary div { display: grid; gap: 6px; }
-.tracking-summary span { color: var(--muted); font-size: .61rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
-.tracking-summary strong { font-size: .75rem; text-transform: capitalize; }
-.timeline--wide { margin-top: 30px; }
+.page-hero--tracking { overflow: hidden; }
+.tracking-hero { grid-template-columns: 1fr auto; align-items: center; }
+.tracking-hero svg { color: #a9c0ad; }
+.tracking-section { max-width: 960px; }
+.tracking-search { padding: 10px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); }
+.tracking-search > svg { margin-left: 8px; color: var(--sage); }
+.tracking-search input { min-width: 0; border: 0; outline: 0; background: transparent; }
+.tracking-hint { margin: 10px 0 24px; font-size: 0.65rem; }
+.tracking-hint button { border: 0; color: var(--forest); background: transparent; font-weight: 750; cursor: pointer; }
+.tracking-result { padding: 24px; border: 1px solid var(--line); border-radius: 13px; background: rgba(255, 253, 248, 0.92); }
+.tracking-summary { margin-bottom: 25px; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
+.tracking-summary > div { padding: 15px; display: grid; gap: 5px; border-right: 1px solid var(--line); background: var(--paper-soft); }
+.tracking-summary > div:last-child { border-right: 0; }
+.tracking-summary span { color: var(--muted); font-size: 0.58rem; }
+.tracking-summary strong { font-size: 0.69rem; text-transform: capitalize; }
+.timeline--wide { margin-bottom: 8px; }
 
 /* Footer */
-.site-footer { color: #d3ddd6; background: var(--forest-dark); }
-.footer-topline { min-height: 135px; display: flex; align-items: center; justify-content: space-between; gap: 30px; border-bottom: 1px solid rgba(255,255,255,.14); }
-.footer-topline span { color: var(--acid); font-family: var(--serif); font-size: clamp(2.4rem, 5vw, 5rem); letter-spacing: -.04em; }
-.footer-topline p { max-width: 420px; color: #9db0a4; text-align: right; }
-.footer-grid { padding: 65px 0; display: grid; grid-template-columns: 1.4fr .7fr .7fr 1fr; gap: 50px; }
-.brand--footer { color: white; }
-.brand--footer span { color: #91a399; }
-.footer-about p { max-width: 360px; margin-top: 20px; }
-.footer-grid > div { display: flex; flex-direction: column; align-items: flex-start; }
-.footer-grid h4 { margin-bottom: 18px; color: white; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }
-.footer-grid p, .footer-grid a { margin-bottom: 9px; color: #91a399; font-size: .7rem; line-height: 1.65; }
-.footer-grid a:hover { color: white; }
-.footer-bottom { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid rgba(255,255,255,.14); color: #82978b; font-size: .63rem; }
