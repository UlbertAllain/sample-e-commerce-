+.page {
+  padding: 28px 0 92px;
+  background:
+    radial-gradient(circle at top left, rgba(182, 168, 144, 0.14), transparent 28%),
+    #efe8dc;
+}
+
+.heroSection {
+  padding-top: 18px;
+}
+
+.heroGrid {
+  display: grid;
+  grid-template-columns: minmax(0, 1.6fr) minmax(300px, 0.95fr);
+  gap: 26px;
+  align-items: start;
+}
+
+.heroCard,
+.sidePanel,
+.productCard,
+.miniCard,
+.galleryPanel,
+.materialBox {
+  border: 1px solid rgba(25, 61, 48, 0.08);
+  border-radius: 28px;
+  background: rgba(255, 255, 255, 0.72);
+  box-shadow: 0 14px 40px rgba(57, 64, 48, 0.08);
+}
+
+.heroCard {
+  position: relative;
+  padding: 22px 24px 26px;
+  overflow: hidden;
+}
+
+.heroTopnav {
+  padding: 6px 4px 18px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 24px;
+  border-bottom: 1px solid rgba(25, 61, 48, 0.12);
+}
+
+.heroTopnav a {
+  color: #31473b;
+  font-size: 0.95rem;
+  font-weight: 500;
+}
+
+.heroContent {
+  display: grid;
+  grid-template-columns: minmax(0, 0.82fr) minmax(320px, 1fr);
+  gap: 16px;
+  align-items: center;
+}
+
+.heroCopy {
+  padding: 34px 0 18px;
+}
+
+.heroCopy h1 {
+  max-width: 440px;
+  color: #17362c;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(3rem, 5.3vw, 5.2rem);
+  font-weight: 500;
+  line-height: 0.94;
+  letter-spacing: -0.05em;
+}
+
+.heroCopy p {
+  max-width: 420px;
+  margin-top: 24px;
+  color: #526255;
+  font-size: 1.05rem;
+  line-height: 1.65;
+}
+
+.heroActions {
+  margin-top: 30px;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 14px;
+}
+
+.secondaryLink {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  color: #2b4739;
+  font-size: 0.92rem;
+  font-weight: 600;
+}
+
+.heroVisualWrap {
+  position: relative;
+  min-height: 470px;
+  display: grid;
+  align-items: end;
+}
+
+.heroVisual {
+  width: 100%;
+  max-height: 470px;
+  object-fit: contain;
+}
+
+.fishDecoration {
+  position: absolute;
+  left: -40px;
+  bottom: 38px;
+  width: 180px;
+  opacity: 0.22;
+}
+
+.floatingCard {
+  position: absolute;
+  right: 22px;
+  bottom: 30px;
+  width: 230px;
+  overflow: hidden;
+  border-radius: 22px;
+  background: rgba(255, 255, 255, 0.94);
+  box-shadow: 0 18px 44px rgba(54, 55, 39, 0.16);
+}
+
+.floatingCardImage {
+  padding: 12px;
+}
+
+.floatingCardImage img {
+  width: 100%;
+  aspect-ratio: 1.1;
+  object-fit: cover;
+  border-radius: 16px;
+}
+
+.floatingCardBody {
+  padding: 0 16px 16px;
+}
+
+.floatingCardBody a,
+.miniCardBody a,
+.productCardBody a {
+  display: block;
+  margin: 10px 0 8px;
+  color: #24352d;
+  font-size: 1rem;
+  font-weight: 700;
+  line-height: 1.3;
+}
+
+.floatingCardBody p,
+.miniCardBody p,
+.productCardBody p {
+  min-height: 44px;
+  color: #6a766b;
+  font-size: 0.88rem;
+  line-height: 1.5;
+}
+
+.floatingCardBody strong,
+.miniCardBody strong,
+.productCardBody strong {
+  display: inline-block;
+  margin-top: 12px;
+  color: #20634f;
+  font-size: 1rem;
+}
+
+.sidePanel {
+  padding: 18px 18px 22px;
+}
+
+.sidePanelHeading,
+.sectionHeading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.sidePanelHeading h2,
+.sectionHeading h2 {
+  color: #1f3a2e;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(1.8rem, 2.5vw, 3rem);
+  font-weight: 500;
+  letter-spacing: -0.04em;
+}
+
+.sidePanelHeading a {
+  color: #4a5c50;
+  font-size: 0.86rem;
+  font-weight: 600;
+}
+
+.sidePanelList {
+  margin-top: 16px;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.miniCard,
+.productCard {
+  overflow: hidden;
+}
+
+.miniCardImage,
+.productCardImage {
+  position: relative;
+  padding: 10px;
+}
+
+.miniCardImage img,
+.productCardImage img {
+  width: 100%;
+  aspect-ratio: 0.98;
+  object-fit: cover;
+  border-radius: 16px;
+}
+
+.miniCardBody,
+.productCardBody {
+  padding: 0 14px 16px;
+}
+
+.tag {
+  display: inline-flex;
+  align-items: center;
+  min-height: 28px;
+  padding: 0 10px;
+  border-radius: 999px;
+  color: white;
+  background: rgba(26, 59, 47, 0.88);
+  font-size: 0.72rem;
+  font-weight: 600;
+}
+
+.miniCardImage .tag,
+.productCardImage .tag {
+  position: absolute;
+  top: 20px;
+  left: 20px;
+}
+
+.catalogSection {
+  padding-top: 28px;
+}
+
+.catalogGrid {
+  display: grid;
+  grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.9fr);
+  gap: 26px;
+  align-items: start;
+}
+
+.productRow {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 18px;
+  margin-top: 16px;
+}
+
+.galleryPanel {
+  padding: 18px;
+}
+
+.inspirationGrid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: 18px;
+}
+
+.inspirationItem {
+  overflow: hidden;
+  border-radius: 18px;
+  background: rgba(255, 255, 255, 0.75);
+}
+
+.inspirationItem img {
+  width: 100%;
+  aspect-ratio: 1.05;
+  object-fit: cover;
+}
+
+.inspirationItem span {
+  display: block;
+  padding: 10px 10px 12px;
+  color: #31473a;
+  font-size: 0.84rem;
+  font-weight: 600;
+}
+
+.materialBox {
+  margin-top: 16px;
+  padding: 18px 20px;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 16px;
+}
+
+.materialBox strong {
+  display: inline-block;
+  margin-bottom: 8px;
+  color: #24392f;
+  font-size: 0.95rem;
+}
+
+.materialBox ul {
+  margin: 0;
+  padding-left: 18px;
+  color: #657369;
+  line-height: 1.7;
+  font-size: 0.88rem;
+}
+
+@media (max-width: 1180px) {
+  .heroGrid,
+  .catalogGrid,
+  .heroContent {
+    grid-template-columns: 1fr;
+  }
+
+  .sidePanelList,
+  .productRow {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+
+  .heroVisualWrap {
+    min-height: 360px;
+  }
+
+  .floatingCard {
+    position: relative;
+    right: auto;
+    bottom: auto;
+    margin: 18px 0 0 auto;
+    width: min(240px, 100%);
+  }
+}
+
+@media (max-width: 860px) {
+  .sidePanelList,
+  .productRow,
+  .inspirationGrid,
+  .materialBox {
+    grid-template-columns: 1fr 1fr;
+  }
+
+  .heroCopy h1 {
+    font-size: 3rem;
+  }
+}
+
+@media (max-width: 640px) {
+  .page {
+    padding: 18px 0 72px;
+  }
+
+  .heroCard,
+  .sidePanel,
+  .galleryPanel,
+  .productCard,
+  .miniCard,
+  .materialBox {
+    border-radius: 22px;
+  }
+
+  .heroTopnav {
+    gap: 14px;
+  }
+
+  .heroCopy {
+    padding-top: 22px;
+  }
+
+  .heroCopy h1 {
+    font-size: 2.4rem;
+  }
+
+  .heroCopy p {
+    font-size: 0.96rem;
+  }
+
+  .sidePanelList,
+  .productRow,
+  .inspirationGrid,
+  .materialBox {
+    grid-template-columns: 1fr;
+  }
+
+  .fishDecoration {
+    display: none;
+  }
+}
