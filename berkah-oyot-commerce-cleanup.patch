 }
+
+/* ===== V3.1 COMMERCE CLEANUP ===== */
+.section--compact { padding: 64px 0; }
+
+.commerce-hero {
+  padding: 44px 0 24px;
+}
+.commerce-hero__grid {
+  display: grid;
+  grid-template-columns: .9fr 1.1fr;
+  align-items: center;
+  gap: 44px;
+}
+.commerce-hero__copy h1 {
+  margin: 14px 0 16px;
+  max-width: 650px;
+  font-size: clamp(3rem, 5.5vw, 5.2rem);
+  line-height: .98;
+  letter-spacing: -.06em;
+}
+.commerce-hero__copy p {
+  max-width: 560px;
+  font-size: 1rem;
+}
+.commerce-hero__actions {
+  margin-top: 28px;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+.commerce-hero__visual {
+  padding: 16px;
+  border: 1px solid var(--line);
+  border-radius: 30px;
+  background: #fff;
+}
+.commerce-hero__visual img {
+  width: 100%;
+  border-radius: 22px;
+}
+
+.category-strip {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: 12px;
+}
+.category-strip__item {
+  min-height: 102px;
+  padding: 16px;
+  display: grid;
+  place-items: center;
+  gap: 10px;
+  border: 1px solid var(--line);
+  border-radius: 22px;
+  background: #fff;
+  text-align: center;
+  transition: transform .18s ease, border-color .18s ease;
+}
+.category-strip__item:hover {
+  transform: translateY(-3px);
+  border-color: #bfc9e6;
+}
+.category-strip__item span {
+  width: 42px;
+  height: 42px;
+  display: grid;
+  place-items: center;
+  border-radius: 15px;
+  background: #eef0ff;
+}
+.category-strip__item strong {
+  font-size: .78rem;
+}
+
+.section-heading--clean h2 {
+  margin-top: 8px;
+  font-size: clamp(2.2rem, 4vw, 3.6rem);
+  line-height: 1;
+}
+
+.benefit-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px;
+}
+.benefit-card {
+  padding: 22px;
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 14px;
+  border: 1px solid var(--line);
+  border-radius: 22px;
+  background: #fff;
+}
+.benefit-card__icon {
+  width: 44px;
+  height: 44px;
+  display: grid;
+  place-items: center;
+  border-radius: 15px;
+  color: #6b55f8;
+  background: #eef0ff;
+}
+.benefit-card strong {
+  display: block;
+  margin-bottom: 6px;
+  font-size: .92rem;
+}
+.benefit-card p {
+  font-size: .8rem;
+  line-height: 1.5;
+}
+
+.promo-simple {
+  padding: 34px 36px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 22px;
+  border-radius: 28px;
+  color: white;
+  background: linear-gradient(135deg, #6b55f8 0%, #24a673 100%);
+}
+.promo-simple span {
+  font-size: .72rem;
+  font-weight: 800;
+  letter-spacing: .12em;
+}
+.promo-simple h2 {
+  margin: 8px 0;
+  font-size: clamp(2rem, 4vw, 3.2rem);
+}
+.promo-simple p { color: rgba(255,255,255,.78); }
+.promo-simple .button--secondary {
+  color: var(--ink);
+  background: white;
+  border-color: white;
+}
+
+.footer-showcase { display: none; }
+
+@media (max-width: 960px) {
+  .commerce-hero__grid { grid-template-columns: 1fr; }
+  .category-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .benefit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 720px) {
+  .section--compact { padding: 44px 0; }
+  .commerce-hero { padding-top: 24px; }
+  .commerce-hero__copy h1 { font-size: 2.65rem; }
+  .category-strip,
+  .benefit-grid { grid-template-columns: 1fr 1fr; }
+  .promo-simple {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+}
